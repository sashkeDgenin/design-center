# Neon Postgres connection string.
# Neon: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/leaddesk?sslmode=require
# Local dev also works with any plain Postgres URL; the driver is picked automatically.
DATABASE_URL=

# The single passcode that unlocks the app. There is no user table and no signup.
# Pick something you can thumb in quickly on a phone.
APP_PASSCODE=

# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
