# ─── DATABASE_URL ────────────────────────────────────────────────────────────
# Your Neon Postgres connection string. Neon Console → your project → Connect,
# then copy the string from the modal. It looks like:
#   postgresql://USER:PASSWORD@ep-something-a1b2c3-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
# This is the value the running app uses for every query.
DATABASE_URL=

# ─── DATABASE_URL_UNPOOLED (optional, Neon only) ─────────────────────────────
# The same database, without the connection pooler. In the Connect modal, switch
# "Connection pooling" off and copy again; the only difference is that "-pooler"
# disappears from the hostname.
# Migrations use this when it is set. The pooler runs PgBouncer in transaction
# mode, which has no session state, so schema changes can hang or fail through it.
# Leave blank on a plain local Postgres: there is only one URL there.
DATABASE_URL_UNPOOLED=

# ─── APP_PASSCODE ────────────────────────────────────────────────────────────
# You invent this. It is the only thing standing between the internet and your
# lead list, and you will thumb it in on a phone, so make it long enough to matter
# but easy to type. There is no username, no signup, no reset link.
APP_PASSCODE=

# ─── SESSION_SECRET ──────────────────────────────────────────────────────────
# Random bytes used to sign your session cookie so it cannot be forged. Not
# something you choose or ever type again. Generate it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it later signs you out; it does not touch your data.
SESSION_SECRET=
